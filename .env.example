# Database
# For local development (default):
# DATABASE_URL="file:./packages/db/data/dev.db"

# For production (Turso - https://turso.tech):
# 1. Create account: turso auth signup
# 2. Create database: turso db create whatsapp-reminder-app
# 3. Get URL: turso db show whatsapp-reminder-app --url
# 4. Get token: turso db tokens create whatsapp-reminder-app
DATABASE_URL="file:./packages/db/data/dev.db"
TURSO_AUTH_TOKEN=""

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Twilio WhatsApp (Get these from: https://console.twilio.com)
TWILIO_ACCOUNT_SID="your_account_sid_here"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_WHATSAPP_NUMBER="+14155238886"
