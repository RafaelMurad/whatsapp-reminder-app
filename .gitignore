# Dependencies
node_modules/
.pnpm-store/

# Environment variables
.env
.env*.local

# Build outputs
dist/
.output/
.vinxi/
.vercel/
.netlify/
**/*.tsbuildinfo

# TypeScript declaration & source maps (generated; not hand-authored)
**/*.d.ts
**/*.d.ts.map
**/*.js.map
**/*.jsx.map

# Transpiled JS/JSX in source tree (web tsc build artifacts)
apps/web/src/**/*.js
apps/web/src/**/*.jsx

# Database
*.db
*.db-journal
*.db-shm
*.db-wal
packages/db/prisma/migrations/
packages/db/drizzle/
packages/db/data/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/

# Misc
.turbo/

# WhatsApp Web.js session data (contains auth tokens - do not commit!)
.wwebjs_auth/
.wwebjs_cache/

# Prevent committing accidental local build config outputs
apps/web/app.config.*
*.timestamp*.js

# Next.js build output
.next/
