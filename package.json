{
  "name": "whatsapp-reminder-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm build:packages",
    "build:packages": "pnpm --filter @repo/db exec tsc && pnpm --filter @repo/api exec tsc",
    "dev": "./dev.sh",
    "build": "pnpm build:packages && pnpm --filter web build",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:push": "pnpm --filter @repo/db push",
    "db:migrate": "pnpm --filter @repo/db push"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
